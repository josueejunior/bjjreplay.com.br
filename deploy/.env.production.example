# Copie para a raiz do projeto no servidor:
#   cp deploy/.env.production.example .env
#
# O script deploy/pm2/setup-and-start.sh cria .env automaticamente se não existir.

# Obrigatório — deixe vazio para o script gerar automaticamente
JWT_SECRET=

# Domínio de produção (CORS do backend)
CORS_ORIGIN=https://bjjreplay.com.br,https://www.bjjreplay.com.br

# Portas locais (Apache/Nginx faz proxy para estas)
FRONT_PORT=7870
BACK_PORT=7871

DOMAIN=bjjreplay.com.br

# Front — vazio = mesma origem (/api via proxy reverso)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_USE_MOCKS=false
